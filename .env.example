# Supabase Configuration (SvelteKit standard)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Direct Database Connection (Optional / Migrations)
DATABASE_URL=postgresql://postgres.xxx:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxx:password@host:5432/postgres

# Google OAuth & Integrations
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google-sheets/callback

# AI Provider
AI_PROVIDER=nineRouter

# 9router (wajib jika menggunakan 9router)
NINE_ROUTER_BASE_URL=https://rikumaru02-9router.hf.space/v1
NINE_ROUTER_API_KEY=your-9router-api-key
NINE_ROUTER_MODEL=combo1

# Providers lain (opsional)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-4-5
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
